# 复制本文件为 .env 并填入真实密钥

# ===== 多模型 Provider 配置 =====
# 当前使用的 provider: openai / zhipu / qwen / ernie / ollama
LLM_PROVIDER=openai

# 通用模型参数
MODEL_NAME=qwen-turbo
TEMPERATURE=0

# OpenAI 兼容服务（含通义千问 DashScope）
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM（LLM_PROVIDER=zhipu 时使用）
# 官方 base_url 已固定，model 可用 glm-4 / glm-4-flash / glm-3-turbo
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 百度文心（LLM_PROVIDER=ernie 时使用）
ERNIE_API_KEY=
ERNIE_SECRET_KEY=
ERNIE_API_BASE=https://qianfan.baidubce.com/v2

# Ollama 本地推理（LLM_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://localhost:11434

# Tavily 联网搜索 API Key
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# 持久化后端：memory（重启丢失）或 sqlite（落盘）
CHECKPOINT_BACKEND=memory
SQLITE_CHECKPOINT_PATH=checkpoints.db

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# ===== RAG 知识库配置 =====
# 向量数据库持久化目录
CHROMA_PERSIST_DIR=./chroma_db
# Embedding provider: openai / ollama
EMBEDDING_PROVIDER=openai
# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-3-small
# 文档切片大小（字符数）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 检索返回的最大文档数
RAG_TOP_K=3

# ===== 业务系统集成配置 =====
# CRM 集成（true 使用模拟数据，false 对接真实 API）
CRM_USE_MOCK=true

# 企业微信 Webhook 通知（在群聊中添加机器人后获取 URL）
# 示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxx
WECOM_WEBHOOK_URL=

# SMTP 邮件发送（以 QQ 邮箱为例，其他邮箱替换 host/port 即可）
# QQ 邮箱：smtp.qq.com:465（SSL）  网易163：smtp.163.com:465  Gmail：smtp.gmail.com:587（TLS）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDR=
SMTP_USE_SSL=true

# ===== API 安全配置 =====
# API Key 鉴权（管理员权限，拥有全部操作含删除；为空则不启用，生产环境务必配置）
# 客户端通过 X-API-Key 或 Authorization: Bearer 传递
API_KEY=
# 写权限 API Key（可上传/更新知识库，不可删除）。逗号分隔配置多个
WRITE_API_KEYS=
# 只读 API Key（仅可对话与查询，不可修改知识库/会话）。逗号分隔配置多个
READONLY_API_KEYS=
# 是否强制要求鉴权（True 时 API_KEY 未配置则非公开端点全部拒绝，防生产裸奔）
AUTH_REQUIRED=true
# 限流：每分钟每个客户端最大请求数（0 表示不限制）
RATE_LIMIT_PER_MINUTE=60
# 写操作端点独立限流（每分钟每客户端，0 表示不额外限制）
RATE_LIMIT_WRITE_PER_MINUTE=20
# 是否信任 X-Forwarded-For / X-Real-IP 头（反向代理后启用，否则所有限流命中代理 IP）
TRUST_FORWARDED_HEADERS=false
# CORS 允许的来源（逗号分隔，* 表示全部允许但此时 credentials 强制关闭；生产建议指定域名如 https://example.com）
CORS_ALLOWED_ORIGINS=http://localhost:8501
# 是否启用 API 文档（/docs /redoc /openapi.json），生产环境建议关闭
DOCS_ENABLED=false
# M3 HTTPS 强制：是否将 HTTP 请求 301 重定向到 HTTPS
# 生产环境启用（配合反向代理 TLS 终止），开发环境关闭（本地 http:// 访问）
# 启用后：HTTP 请求（非 /health）被重定向到 HTTPS，/health 豁免供容器探活
# 反向代理后需同时设置 TRUST_FORWARDED_HEADERS=true 才能正确识别 X-Forwarded-Proto
FORCE_HTTPS=false
# M4 请求体大小限制（字节），超过返回 413 Payload Too Large
# 防 DoS：在请求体读入内存前拦截，避免超大请求体耗尽内存
# 默认 10MB，覆盖知识库批量上传（100KB × 50 ≈ 5MB）
MAX_REQUEST_BODY_SIZE=10485760
# M4 Uvicorn 硬化：keep-alive 空闲连接超时（秒），防 Slowloris 慢速攻击
# 默认 5s，生产环境不建议调大
UVICORN_TIMEOUT_KEEP_ALIVE=5
# M4 Uvicorn 硬化：最大并发连接数，超限返回 503，防连接耗尽 DoS
# 0 表示不限制，生产环境建议按机器规格设置（如 100-1000）
UVICORN_LIMIT_CONCURRENCY=100
# 知识库敏感检测模式：off（不扫描）/ warn（警告但允许上传）/ block（拒绝上传）
KNOWLEDGE_SENSITIVE_SCAN=warn
# SMTP 收件人域名白名单（逗号分隔，如 company.cn,internal.com；为空表示不限制）
SMTP_ALLOWED_DOMAINS=

# ===== 日志配置 =====
# 日志格式：text（传统文本）或 json（结构化，便于接入 ELK/Loki/Datadog）
LOG_FORMAT=text

# ===== 告警配置 =====
# 后台告警 watcher 线程开关（启动后周期性扫描指标，触发阈值时调用告警回调）
ALERT_WATCHER_ENABLED=true
# 扫描间隔（秒）
ALERT_WATCHER_INTERVAL=60

# ===== 缓存配置（v2.0.0+）=====
# 各类缓存独立开关
CACHE_LLM_ENABLED=true
CACHE_EMBEDDING_ENABLED=true
CACHE_RAG_SEARCH_ENABLED=true
# LLM 路由缓存
CACHE_LLM_MAXSIZE=256
CACHE_LLM_TTL=300
# Embedding 向量缓存
CACHE_EMBEDDING_MAXSIZE=1024
CACHE_EMBEDDING_TTL=1800
# RAG 检索结果缓存
CACHE_RAG_MAXSIZE=128
CACHE_RAG_TTL=120
